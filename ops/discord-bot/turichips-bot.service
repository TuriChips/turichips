[Unit]
Description=Turichips Discord bot
After=network-online.target
Wants=network-online.target

[Service]
User=turichips
WorkingDirectory=/home/turichips/turichips/ops/discord-bot
EnvironmentFile=/home/turichips/.turichips.env
Environment=PATH=/home/turichips/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/turichips/venv/bin/python bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
